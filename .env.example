# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (no trailing slash). Used for canonicals, sitemap, OG tags and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://snifffr.org

# Where every "Start Selling" button points (optional; defaults to the value in lib/site.ts).
# NEXT_PUBLIC_AFFILIATE_URL=https://...

# Public contact address shown on the Contact / Privacy pages (optional).
# NEXT_PUBLIC_CONTACT_EMAIL=hello@snifffr.org

# ---- CMS login (/admin) ----
ADMIN_EMAIL=admin@example.com
# Generate with:  npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=scrypt:<salt>:<hash>
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Set to "false" only if you serve the production build over plain HTTP (not recommended).
# COOKIE_SECURE=false

# ---- Search engine verification (optional) ----
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---- Storage locations (optional; default to ./content and ./data) ----
# CONTENT_DIR=/var/lib/snifffr/content
# DATA_DIR=/var/lib/snifffr/data

# ---- Serverless storage (Vercel) ----
# Turso / libSQL database for posts + contact messages. Without it, JSON files in ./content and ./data are used.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# Vercel Blob for uploaded images. Without it, images are saved to ./content/uploads.
# BLOB_READ_WRITE_TOKEN=

# ---- Indexing ----
# true = keep the whole site out of search engines (noindex meta + X-Robots-Tag header)
# SITE_NOINDEX=true
